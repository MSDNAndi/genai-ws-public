{
  "$comment": "Provider profiles. Every sample in this repo talks to ONE of these. Values of the form ${VAR} are read from the environment (or .env). Pick one with GENAI_PROFILE=<name>, or pass --profile <name> to any sample.",
  "default": "foundry",
  "profiles": {
    "foundry": {
      "label": "Course endpoint (Microsoft Foundry via APIM) - OpenAI-compatible",
      "base_url": "${GENAI_BASE_URL}",
      "api_key": "${GENAI_API_KEY}",
      "key_header": "api-key",
      "model": "${GENAI_MODEL:-gpt-5-mini}",
      "embed_model": "${GENAI_EMBED_MODEL:-text-embedding-3-large}"
    },
    "foundry-direct": {
      "label": "Your own Foundry resource, no gateway",
      "base_url": "${AZURE_FOUNDRY_ENDPOINT}/openai/v1",
      "api_key": "${AZURE_FOUNDRY_API_KEY}",
      "key_header": "api-key",
      "model": "${AZURE_FOUNDRY_MODEL:-gpt-5-mini}",
      "embed_model": "text-embedding-3-large"
    },
    "openai": {
      "label": "OpenAI platform",
      "base_url": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}",
      "key_header": "authorization",
      "model": "${OPENAI_MODEL:-gpt-5.2}",
      "embed_model": "text-embedding-3-large"
    },
    "openrouter": {
      "label": "OpenRouter - the whole zoo behind one key",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key": "${OPENROUTER_API_KEY}",
      "key_header": "authorization",
      "model": "${OPENROUTER_MODEL:-deepseek/deepseek-v3.2}",
      "embed_model": "openai/text-embedding-3-large"
    },
    "ollama": {
      "label": "Local Ollama",
      "base_url": "${OLLAMA_BASE_URL:-http://localhost:11434/v1}",
      "api_key": "ollama",
      "key_header": "authorization",
      "model": "${OLLAMA_MODEL:-gemma4:e4b}",
      "embed_model": "${OLLAMA_EMBED_MODEL:-bge-m3}"
    },
    "lmstudio": {
      "label": "Local LM Studio",
      "base_url": "${LMSTUDIO_BASE_URL:-http://localhost:1234/v1}",
      "api_key": "lm-studio",
      "key_header": "authorization",
      "model": "${LMSTUDIO_MODEL:-qwen3.8-27b}",
      "embed_model": "text-embedding-bge-m3"
    },
    "foundry-local": {
      "label": "Foundry Local (Windows, NPU/GPU)",
      "base_url": "${FOUNDRY_LOCAL_BASE_URL:-http://localhost:5273/v1}",
      "api_key": "foundry-local",
      "key_header": "authorization",
      "model": "${FOUNDRY_LOCAL_MODEL:-qwen3.5-9b}",
      "embed_model": "qwen3-embedding-0.6b"
    },
    "mock": {
      "label": "Offline mock server (tools/mock_server.py) - no key, no network",
      "base_url": "${MOCK_BASE_URL:-http://localhost:8080/v1}",
      "api_key": "mock",
      "key_header": "authorization",
      "model": "mock-model-1",
      "embed_model": "mock-embed-1"
    }
  }
}