# Copy to .env (git-ignored). Real shell environment variables always win over this file.
# Which provider profile the samples use by default (see providers.json):
GENAI_PROFILE=foundry

# --- foundry: the endpoint + key you get handed at the workshop ---------------
GENAI_BASE_URL=https://apim-<event>.azure-api.net/openai/v1
GENAI_API_KEY=
GENAI_MODEL=gpt-5-mini
GENAI_EMBED_MODEL=text-embedding-3-large

# --- foundry-direct: your own Foundry resource -------------------------------
AZURE_FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=gpt-5-mini

# --- openai / openrouter: only if you bring your own ------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- local runners: no key needed -------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e4b
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Foundry Local 0.10+ picks a random port unless started with a fixed one:
#   foundry server start -p 5273   (then: foundry model load qwen3.5-9b)
FOUNDRY_LOCAL_BASE_URL=http://localhost:5273/v1

# --- optional demo keys (segment 1 tool-calling sample) ----------------------
OPENROUTESERVICE_API_KEY=

# --- settings read directly by the Segment 2 + 4 samples (ported from the labs) ---
GENAI_KEY_HEADER=api-key
# reasoning models (gpt-5*): low keeps demos snappy; delete for non-reasoning models
GENAI_REASONING_EFFORT=low
GENAI_MODEL_2=DeepSeek-V3.2
GENAI_IMAGE_MODEL=gpt-image-1-mini
GENAI_TTS_MODEL=gpt-4o-mini-tts
# a local llama.cpp server (llama-server --port 8091 ...) - sample 4.01 measures it too
LLAMACPP_BASE_URL=http://localhost:8091/v1
# sample 1.02 (sampling knobs) needs a NON-reasoning model - gpt-5*/gpt-6* reject temperature
GENAI_SAMPLING_MODEL=gpt-4.1
# sample 1.02, reasoning_effort part: needs a REASONING model (gpt-5*, gpt-6*)
GENAI_REASONING_MODEL=gpt-5-mini
