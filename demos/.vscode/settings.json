{
  // Open this folder (not a single file) and every sample uses the repo's uv environment:
  // run cells (# %%) with Shift+Enter, the Interactive window uses the same interpreter.
  // Create/refresh it with `uv sync`. Settings and keys come from .env (git-ignored).
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.envFile": "${workspaceFolder}/.env",
  "python.terminal.activateEnvironment": true,
  "jupyter.interactiveWindow.creationMode": "perFile",
  "jupyter.interactiveWindow.textEditor.executeSelection": true
}
