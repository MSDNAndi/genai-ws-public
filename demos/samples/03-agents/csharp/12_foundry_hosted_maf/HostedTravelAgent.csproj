<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The one real project among the samples: a container build only sees this
       folder, so a file-based app with a #:project reference would not build. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- preview hosting packages: silence audit/downgrade noise, as Microsoft's sample does -->
    <NoWarn>$(NoWarn);NU1903;NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- AgentHost, AddFoundryResponses, MapFoundryResponses (+ AIProjectClient.AsAIAgent) -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.22.0-preview.260918.1" />
    <!-- local mode: ChatClient.AsAIAgent against any OpenAI-compatible endpoint -->
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.22.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

</Project>
