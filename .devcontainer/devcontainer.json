{
  // Building Stuff with GenAI: one click, everything installed. Python 3.12 + .NET 10 + Node 24, all lab packages.
  // Attendees open it in their own GitHub account: https://codespaces.new/msdnAndi/genai-ws-public?quickstart=1
  "name": "Building Stuff with GenAI",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    // gh: make a forwarded port public in one command (Lab 3 A2A): gh codespace ports visibility 8100:public -c $CODESPACE_NAME
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },

  // The only thing an attendee types: the room key, on the "Create codespace" page.
  // It arrives as an environment variable, and every lab lets environment variables win over labs/.env.
  "secrets": {
    "GENAI_API_KEY": {
      "description": "The workshop key from your card. Using your own endpoint instead? Leave this empty and see labs/START-HERE.md."
    }
  },

  // labs/.venv first on PATH: `python 01_hello.py` works in every terminal without activating anything.
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/labs/.venv/bin:${containerEnv:PATH}",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },

  // Web UIs from the labs open in a browser tab automatically (Ports tab shows them too)
  "portsAttributes": {
    "8090": { "label": "Lab 3 DevUI", "onAutoForward": "openBrowser" },
    "6274": { "label": "MCP Inspector (Lab 2)", "onAutoForward": "openBrowser" },
    "6277": { "label": "MCP Inspector proxy", "onAutoForward": "silent" },
    "8000": { "label": "Lab 4 mix & match (out/chain.html)", "onAutoForward": "openBrowser" },
    "8188": { "label": "ComfyUI / stand-in (Lab 4)", "onAutoForward": "silent" }
  },

  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postAttachCommand": "bash .devcontainer/welcome.sh",

  "customizations": {
    "codespaces": { "openFiles": ["labs/START-HERE.md"] },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-dotnettools.csharp",
        "GitHub.copilot-chat",
        // one ▶ "Run Code" button on every lab file: Python, C# (dotnet run --file) and TypeScript/JavaScript (node)
        "formulahendry.code-runner"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/labs/.venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.cwd": "${containerWorkspaceFolder}/labs",
        "editor.fontSize": 15,
        "terminal.integrated.fontSize": 15,
        "workbench.startupEditor": "none",
        // Markdown (START-HERE, lab READMEs) opens rendered, with copy buttons on the commands
        "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor", "*.ipynb": "jupyter-notebook" },
        // Demo notebooks (demos/notebooks): Run All uses labs/.venv, never the image's bare system Python
        "jupyter.kernels.excludePythonEnvironments": ["/usr/local/bin/python", "/usr/local/python/current/bin/python", "/usr/bin/python3"],
        // ▶ Run Code (top right of the editor, or Ctrl+Alt+N): runs the open file in the terminal, from its own folder
        "code-runner.runInTerminal": true,
        "code-runner.saveFileBeforeRun": true,
        "code-runner.fileDirectoryAsCwd": true,
        "code-runner.clearPreviousOutput": true,
        "code-runner.showRunIconInEditorTitleMenu": true,
        "code-runner.executorMap": {
          "python": "python -u \"$fullFileName\"",
          "csharp": "dotnet run --file \"$fullFileName\"",
          "javascript": "node \"$fullFileName\"",
          "typescript": "node \"$fullFileName\""
        },
        "csharp.suppressBuildAssetsNotification": true,
        // .NET 10 is already installed: stop the C# extension's ".NET install" attempt (red popup "No version was defined")
        "dotnetAcquisitionExtension.existingDotnetPath": [ { "extensionId": "ms-dotnettools.csharp", "path": "/usr/share/dotnet/dotnet" } ]
      }
    }
  }
}
