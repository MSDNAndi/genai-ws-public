# Building Stuff with GenAI: settings for the workshop endpoint (Live! 360 Orlando, 2026-11-16).
# The key is NOT in this file: it comes from the GENAI_API_KEY codespace secret you entered when creating the codespace.
# Forgot it? Add a line   GENAI_API_KEY=<the key from your card>   below and save.
# Your own endpoint instead (Azure AI Foundry, OpenAI, ...)? More than the key changes: see labs/START-HERE.md.

GENAI_BASE_URL=https://genaiclass-apim-7slyc.azure-api.net/openai/v1
GENAI_KEY_HEADER=api-key
GENAI_MODEL=gpt-5-mini
GENAI_REASONING_EFFORT=low
GENAI_MODEL_2=DeepSeek-V3.2
GENAI_EMBED_MODEL=text-embedding-3-large
GENAI_IMAGE_MODEL=gpt-image-1-mini
GENAI_TTS_MODEL=gpt-4o-mini-tts

# Other models on the same endpoint, same key: gpt-6-astra, gpt-5.5, gpt-4.1 (no reasoning: use it for temperature),
# DeepSeek-V3.2. Switch by changing GENAI_MODEL. For gpt-4.1 / gpt-4o delete the GENAI_REASONING_EFFORT line.
