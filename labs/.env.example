# Building Stuff with GenAI — lab settings.
# Copy this file to labs/.env and fill it in from your handout card. Real environment variables win over this file.
# Never commit labs/.env (it is in .gitignore).

# --- The workshop endpoint: Azure AI Foundry behind the workshop API gateway (OpenAI-compatible /openai/v1) ---
GENAI_BASE_URL=https://<gateway-from-your-card>/openai/v1
GENAI_API_KEY=<your-personal-key>
# api-key = the key also travels in an "api-key" header (workshop gateway, Foundry; Ollama ignores it).
# Authorization = Bearer token only (OpenAI, OpenRouter, Hugging Face router).
GENAI_KEY_HEADER=api-key
# Default chat model (a deployment name on the endpoint)
GENAI_MODEL=gpt-5-mini
# Reasoning models think before answering (billed, slower). low/minimal keeps the labs snappy; delete the line for
# models that reject the parameter (non-reasoning models).
GENAI_REASONING_EFFORT=low
# A second vendor on the SAME endpoint and key (Lab 1 step 5, Lab 3 stretch) — e.g. DeepSeek-V3.2, grok-4-fast, Kimi-K2.6
GENAI_MODEL_2=DeepSeek-V3.2
# Embeddings (Lab 2)
GENAI_EMBED_MODEL=text-embedding-3-large
# Media without a GPU (Lab 4)
GENAI_IMAGE_MODEL=gpt-image-1-mini
GENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Local runtimes (Lab 1 step 5, Lab 4) — pre-pull the models before the day, see labs/00-setup/SETUP.md ---
OLLAMA_BASE_URL=http://localhost:11434/v1
# Default local chat model: qwen3.5:4b (3.4 GB, tools + thinking). Smaller: qwen3.5:2b (2.7 GB), llama3.2:3b (2.0 GB).
# Multimodal incl. audio in: gemma4:e4b (9.6 GB download!)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=bge-m3
# "none" switches off the thinking phase of local reasoning models (Qwen 3.x, Gemma 4 ...) — much faster on a laptop CPU
OLLAMA_REASONING_EFFORT=none
# LM Studio's server (optional): http://localhost:1234/v1 · Foundry Local prints its URL with `foundry service status`
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# ComfyUI (Lab 4, only if you run it locally)
COMFYUI_URL=http://127.0.0.1:8188

# --- Offline fallback: the instructor's mock server (answers are echoes, but every lab script runs) ---
# GENAI_BASE_URL=http://127.0.0.1:8123/v1
# GENAI_API_KEY=test
# GENAI_MODEL=mock-model
